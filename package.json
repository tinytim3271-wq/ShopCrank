{
  "name": "shopcrank-desktop",
  "version": "1.1.0",
  "description": "ShopCrank Dispatch & Work Orders Windows desktop client",
  "main": "desktop/main.js",
  "author": "ShopCrank",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node server.mjs",
    "dev:mock": "node server.mjs",
    "start": "node -e \"console.error('server.mjs is a local mock API with a built-in admin session. Use npm run dev or npm run dev:mock locally; production runs on Cloudflare Pages + Workers.'); process.exit(1)\"",
    "build": "npm run build:web",
    "lint": "eslint \"src/main.js\" \"src/shared/**/*.js\" \"src/modules/**/*.js\" \"src/runtime/home.js\" \"src/runtime/legacy.js\" \"src/runtime/filing-overrides.js\" \"src/**/*.test.mjs\"",
    "test": "npm run test:modules && npm run test:licenses",
    "test:licenses": "node --test src/modules/vehicle-key-license.test.mjs worker/test/licenses.test.mjs worker/test/license-worker-e2e.test.mjs",
    "sync:config": "node scripts/sync-frontend-config.mjs",
    "test:config": "node scripts/sync-frontend-config.test.mjs && node scripts/resolve-r2-upload-env.test.mjs && node --test scripts/setup-email-signin.test.mjs && node --test scripts/provision-shopcrank-com.test.mjs",
    "provision:shopcrank-com": "node scripts/provision-shopcrank-com.mjs",
    "verify:google-oauth": "node scripts/verify-google-oauth-cutover.mjs",
    "build:web": "node scripts/sync-frontend-config.mjs && node scripts/build-web.mjs",
    "check:java": "node scripts/require-java21.mjs",
    "dev:web": "node scripts/build-web.mjs --watch",
    "copy:web": "node scripts/copy-web.mjs",
    "dev:worker": "node scripts/dev-worker-local.mjs",
    "dev:worker:remote": "wrangler dev",
    "test:smoke": "node scripts/smoke/browser-smoke.mjs",
    "test:worker": "node --test worker/test/*.test.mjs",
    "test:home": "node --test src/runtime/home.test.mjs",
    "typegen:worker": "wrangler types worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:worker": "wrangler deploy",
    "setup:email": "node scripts/setup-email-signin.mjs",
    "stage:pages": "node scripts/stage-pages.mjs",
    "deploy:pages": "npm run build:web && npm run stage:pages && wrangler pages deploy .pages-dist --project-name=shopcrank-dispatch --branch=main --commit-dirty=true",
    "validate:worker": "npm run test:worker && wrangler deploy --dry-run",
    "validate": "npm run build:web && npm run test:config && npm run test:modules && npm run validate:worker && npm run test:j2534",
    "sync": "npm run check:java && npm run build:web && npm run copy:web && npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "npm run check:java && npm run sync",
    "desktop": "electron .",
    "build:j2534": "node scripts/build-j2534.mjs",
    "build:windows": "npm run build:web && npm run build:j2534 && node scripts/bake-diagnostics-secret.mjs && electron-builder --win nsis --publish never",
    "build:windows:zip": "npm run build:web && npm run build:j2534 && node scripts/bake-diagnostics-secret.mjs && electron-builder --win zip --publish never",
    "build:windows:offline": "node scripts/build-offline-windows.mjs",
    "build:windows:demo": "node scripts/build-offline-windows.mjs --demo",
    "test:j2534": "node diagnostics/j2534-host-node/test/host.test.js",
    "merge:open-prs": "bash scripts/merge-open-prs.sh",
    "test:html": "node --test src/shared/html.test.mjs src/shared/form-fields.test.mjs src/shared/dates.test.mjs",
    "test:chat": "node --test src/modules/chat/utils.test.mjs",
    "test:storage": "node --test src/modules/storage.test.mjs",
    "test:upload": "node --test src/modules/file-upload.test.mjs",
    "test:desktop": "node --test desktop/start-url.test.js desktop/auth-deep-link.test.js desktop/diagnostics-secrets.test.js desktop/diagnostics-bridge.test.js desktop/local-vault.test.js desktop/portable-data.test.js desktop/print-window.test.js",
    "test:offline": "node --test src/modules/offline-desktop.test.mjs",
    "test:mutation": "node --test src/runtime/prepare-entity-mutation.test.mjs src/runtime/entity-persistence.test.mjs src/runtime/mutation-queue-store.test.mjs",
    "test:imports": "node --test src/modules/imports.test.mjs",
    "test:canned": "node --test src/modules/canned-services.test.mjs",
    "test:guides": "node --test src/modules/repair-guide.test.mjs",
    "test:inspections": "node --test src/modules/shop-inspections.test.mjs",
    "test:autozone": "node --test src/modules/autozone-pro.test.mjs",
    "test:repair-flow": "node --test src/modules/repair-order-flow.test.mjs",
    "test:partstech": "node --test src/modules/partstech.test.mjs",
    "test:labor-guide": "node --test src/modules/labor-guide.test.mjs",
    "test:labor-web": "node --test worker/test/labor-web-estimate.test.mjs",
    "test:quickbooks": "node --test src/modules/quickbooks.test.mjs",
    "test:revrec": "node --test src/modules/revenue-recognition.test.mjs",
    "test:estimate": "node -e \"process.exit(require('node:child_process').spawnSync(process.execPath, ['--test', 'src/modules/tax-policy.test.mjs', 'src/modules/estimate-approval.test.mjs', 'src/modules/estimate-workflow.test.mjs', 'src/modules/estimate-templates.test.mjs', 'src/modules/work-order-editor.test.mjs'], { stdio: 'inherit', env: { ...process.env, TZ: 'America/Chicago' } }).status ?? 1)\"",
    "test:payments": "node --test src/modules/payments.test.mjs",
    "test:market": "node --test scripts/market-pages.test.mjs",
    "test:mileage": "node --test src/modules/mileage.test.mjs",
    "test:customer-intake": "node --test src/modules/customer-intake.test.mjs",
    "test:shop-os": "node --test src/modules/shop-os/bay.test.mjs",
    "test:diagnostics-identity": "node --test src/modules/diagnostics/vehicle-identity.test.mjs",
    "test:work-orders": "node --test src/modules/work-order-editor.test.mjs",
    "issue-invite": "node scripts/issue-founding-invite.mjs",
    "test:modules": "npm run test:home && npm run test:mutation && npm run test:html && npm run test:chat && npm run test:storage && npm run test:upload && npm run test:desktop && npm run test:offline && npm run test:imports && npm run test:canned && npm run test:guides && npm run test:inspections && npm run test:autozone && npm run test:repair-flow && npm run test:partstech && npm run test:labor-guide && npm run test:labor-web && npm run test:quickbooks && npm run test:revrec && npm run test:estimate && npm run test:work-orders && npm run test:payments && npm run test:market && node --test src/modules/ai-workflow.test.mjs && node --test src/modules/shop-ai-settings.test.mjs && npm run test:mileage && npm run test:customer-intake && npm run test:filing && npm run test:shell-defects && npm run test:shop-os && npm run test:diagnostics-identity && node --test src/modules/technician-assignment.test.mjs src/modules/intake-wizard.test.mjs src/modules/help-menu.test.mjs src/modules/diagnostic-ai.test.mjs && node --test src/modules/print-document.test.mjs",
    "test:filing": "node --test src/modules/filing/withholding.test.mjs src/modules/filing/jurisdictions.test.mjs",
    "test:shell-defects": "node --test src/runtime/shell-defects.test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "electron": "^42.11.3",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "playwright": "1.63.0",
    "wrangler": "^4.151.0"
  },
  "build": {
    "appId": "com.shopcrank.dispatch",
    "productName": "ShopCrank",
    "protocols": [
      {
        "name": "ShopCrank authentication",
        "schemes": [
          "shopcrank"
        ]
      }
    ],
    "artifactName": "ShopCrank-Setup-${version}.${ext}",
    "publish": null,
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "app.js",
      "diagnostics-ui.js",
      "index.html",
      "styles.css",
      "theme.css",
      "manifest.webmanifest",
      "service-worker.js",
      "shopcrank-icon.svg",
      "assets/**/*",
      "desktop/**/*",
      "diagnostics/j2534-host-node/**/*",
      "diagnostics/coverage/**/*",
      "downloads/**"
    ],
    "extraResources": [
      {
        "from": "diagnostics/j2534-host-node",
        "to": "j2534-host-node",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "diagnostics/j2534-service/publish/win-x64",
        "to": "j2534-host",
        "filter": [
          "J2534.Host.exe"
        ]
      },
      {
        "from": "desktop/packaged-secrets",
        "to": "diagnostics-secrets",
        "filter": [
          "capability-secret.txt"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShopCrank"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@google/genai": "^2.30.0",
    "dompurify": "^3.4.17",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "obd": "^1.0.0",
    "posthog-node": "^5.57.2"
  },
  "overrides": {
    "rimraf": "^4.0.1",
    "glob": "^7.2.3"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "@google/genai@2.30.0": true,
    "protobufjs@7.6.6": true,
    "workerd@1.20261012.1": true
  },
  "engines": {
    "node": ">=24"
  }
}
