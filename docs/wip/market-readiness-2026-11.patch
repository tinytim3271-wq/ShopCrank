+
+/* ── Market-readiness usability fixes (Nov 2026) ───────────────────────────
+   Contrast: every text color below reaches WCAG AA 4.5:1 on its background. */
+:root{--muted:#58646c;--orange-text:#b83a1d}
+.eyebrow{color:var(--orange-text)}
+.nav-label{color:#a9bab3}
+.brand small,.shop-card span,.user-row span,.user-row svg{color:#b4c3bc}
+.tab{color:#55616a}
+
+/* Tap targets: 32px minimum with a mouse, 44px on touch screens. */
+.mini-action{min-height:32px;padding:0 10px}
+.mini-action+.mini-action{margin-left:4px}
+.mini-action.danger{margin-left:12px}
+@media (pointer:coarse){.mini-action,.primary,.secondary,.tab{min-height:44px}}
+
+/* Dispatch board: cards are buttons stretched to the lane's height, and buttons
+   center their content, so the text sank to the bottom. Keep cards top-aligned. */
+.lane-body{align-content:start}
+.job-card{align-self:start}
+
+/* Floating controls live together in the bottom-right corner on desktop so the
+   Help button no longer covers the first content column. */
+@media (min-width:761px){
+  #help-root{left:auto;right:18px;bottom:66px}
+  .help-float{width:42px;padding:0;border-radius:50%;justify-content:center}
+  .help-float span{display:none}
+  .help-panel{left:auto;right:0}
+}
+
+.stat-note.warn{color:var(--orange-text)}
+.job-card .mobile,span.mobile{color:#2a64a8}
+.tab{min-height:32px}
+.template-link{display:inline-flex;align-items:center;min-height:32px}
+
+/* Phone: long attention rows and the payroll week picker wrap instead of widening the page. */
+.home-row{max-width:100%;min-width:0}
+.home-row>span{min-width:0}
+.home-row strong,.home-row small{white-space:normal;overflow-wrap:anywhere}
+main label,main input,main select{max-width:100%}
+
+.payroll-period-controls{flex-wrap:wrap}
+main input[type=checkbox],main input[type=radio]{width:24px;height:24px}
+main button.ghost,.messaging-panel button,.consent-actions button{min-height:32px}
+
+/* Payroll: the actions row was pulled up 55px and landed on the withholding notice. */
+.payroll-actions{margin-top:0}
+
+/* Stat tiles: only an odd last tile spans the row, so four tiles fill a 2x2 grid. */
