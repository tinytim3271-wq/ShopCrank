+  assert.equal(providerBase({ SMOKE_STRIPE_API_BASE: 'http://10.0.0.5/v1' }, 'STRIPE', live), live);
+  assert.equal(providerBase({ SMOKE_STRIPE_API_BASE: 'not a url' }, 'STRIPE', live), live);
+});
