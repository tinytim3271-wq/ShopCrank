+
+  assemble-release:
+    # Signed release APK and AAB for the Play Store. Runs on main once the
+    # ANDROID_KEYSTORE_BASE64 secret exists; otherwise it says what is missing.
+    if: github.event_name == 'push' || github.event_name == 'workflow_dispatch'
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
