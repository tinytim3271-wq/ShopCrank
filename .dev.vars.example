# Local Worker secrets for `wrangler dev` (copy to `.dev.vars` — gitignored).
# Never enable DEV_AUTH_BYPASS in production.

DEV_AUTH_BYPASS=1
ACCESS_ADMIN_EMAILS=admin@example.com
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-value
DIAGNOSTICS_CAPABILITY_SECRET=replace-with-a-different-random-value
# Base64 DER PKCS#8 ECDSA P-256 private key for /api/diagnostics/authorize
DIAGNOSTICS_SIGNING_PRIVATE_KEY=replace-with-base64-pkcs8-p256-private-key

# Conversational AI. With no ANTHROPIC_API_KEY or GEMINI_API_KEY the text
# assistant uses the Workers AI binding from wrangler.jsonc (wrangler dev runs
# it against your Cloudflare account). Set AI_ENABLED=0 to turn the assistant off locally.
AI_ENABLED=1
# Shops can add their own Anthropic or Gemini key in Shop settings > AI
# (encrypted with INTEGRATION_ENCRYPTION_KEY). Platform keys below are optional
# overrides used when a shop has not saved its own key.
# ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key
# SHOP_ANTHROPIC_MODEL=claude-sonnet-5
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# SHOP_GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# AI_TEXT_PROVIDER=anthropic
# DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
# XAI_API_KEY=replace-with-your-xai-api-key

# Configure current contracted provider rates before enabling pass-through billing.
# ANTHROPIC_SONNET_INPUT_USD_PER_MTOK=
# ANTHROPIC_SONNET_OUTPUT_USD_PER_MTOK=
# ANTHROPIC_OPUS_INPUT_USD_PER_MTOK=
# ANTHROPIC_OPUS_OUTPUT_USD_PER_MTOK=
# GEMINI_INPUT_USD_PER_MTOK=
# GEMINI_OUTPUT_USD_PER_MTOK=
# DEEPGRAM_VOICE_USD_PER_MINUTE=
# AI_BILLING_MARKUP_MULTIPLIER=1

# Optional Access simulation when not using DEV_AUTH_BYPASS:
# ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
# ACCESS_AUD=your-access-application-audience

# Magic-link email delivery. Production sender:
# https://www.shopcrank.com/api/auth/send-login
# These local settings are not uploaded by a Worker deployment.
# AUTH_EMAIL_FROM=noreply@shopcrank.com
# AUTH_EMAIL_WEBHOOK=https://www.shopcrank.com/api/auth/send-login
# AUTH_EMAIL_WEBHOOK_SECRET=replace-with-your-webhook-bearer-secret

# Google OpenID Connect. Register this local callback in Google Cloud:
# http://127.0.0.1:8787/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret

# Licensed labor data. Providers supply the exact endpoint and auth contract.
# MOTOR_LABOR_BASE_URL=https://...
# MOTOR_LABOR_SEARCH_PATH=/...
# MOTOR_LABOR_API_KEY=...
# ALLDATA_LABOR_BASE_URL=https://...
# ALLDATA_LABOR_SEARCH_PATH=/...
# ALLDATA_LABOR_API_KEY=...

# Parts catalogs. Configure only operations included in the supplier agreement.
# PARTSTECH_BASE_URL=https://...
# PARTSTECH_API_KEY=...
# PARTSTECH_SEARCH_PATH=/...
# PARTSTECH_QUOTE_PATH=/...
# PARTSTECH_ORDER_PATH=/...
# PARTSTECH_PUNCHOUT_URL=https://...
# NEXPART_BASE_URL=https://...
# NEXPART_API_KEY=...
# NEXPART_SEARCH_PATH=/...
# NEXPART_QUOTE_PATH=/...
# NEXPART_ORDER_PATH=/...
# NEXPART_PUNCHOUT_URL=https://...

# Built-in two-way SMS (Twilio). Complete A2P 10DLC registration before sending.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM_NUMBER=+18065550100
# TWILIO_WEBHOOK_URL=https://www.shopcrank.com/api/messaging/twilio/webhook/your-shop-id

# QuickBooks Online OAuth2.
# INTUIT_CLIENT_ID=...
# INTUIT_CLIENT_SECRET=...
# INTUIT_REDIRECT_URI=https://www.shopcrank.com/api/quickbooks/callback
# INTUIT_ENVIRONMENT=sandbox
# INTUIT_DEFAULT_ITEM_ID=1

# Shop Crank SaaS subscription billing. Create recurring monthly and annual prices.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO_MONTHLY=price_...
# STRIPE_PRICE_SOLO_ANNUAL=price_...
# STRIPE_PRICE_SHOP_MONTHLY=price_...
# STRIPE_PRICE_SHOP_ANNUAL=price_...
# STRIPE_PRICE_SHOP_PRO_MONTHLY=price_...
# STRIPE_PRICE_SHOP_PRO_ANNUAL=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_ANNUAL=price_...
# STRIPE_PRICE_FOUNDING_SOLO_MONTHLY=price_...
# STRIPE_PRICE_FOUNDING_SOLO_ANNUAL=price_...
# STRIPE_PRICE_FOUNDING_SHOP_MONTHLY=price_...
# STRIPE_PRICE_FOUNDING_SHOP_ANNUAL=price_...
# STRIPE_PRICE_FOUNDING_PRO_MONTHLY=price_...
# STRIPE_PRICE_FOUNDING_PRO_ANNUAL=price_...

# Support notifications and public service status.
# SUPPORT_EMAIL_TO=support@shopcrank.com
# SUPPORT_EMAIL_FROM=support@shopcrank.com
# STATUS_PAGE_URL=https://status.shopcrank.com
# PartsTech / MOTOR labor (per-shop credentials are stored encrypted in D1;
# these optional overrides are only for local stubbing of the API base URL).
# PARTSTECH_API_BASE=https://api.partstech.com

# QuickBooks Online OAuth app (Intuit Developer). Per-shop tokens are encrypted in D1.
# Register redirect: https://www.shopcrank.com/api/integrations/quickbooks/callback
# (local: http://127.0.0.1:8787/api/integrations/quickbooks/callback — the SPA posts code/state/realmId)
# QUICKBOOKS_CLIENT_ID=replace-with-intuit-client-id
# QUICKBOOKS_CLIENT_SECRET=replace-with-intuit-client-secret
# QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:8787/qbo/callback
# QUICKBOOKS_SANDBOX=1

# Labor web fallback (used only when no MOTOR/ALLDATA/ShopKey provider is connected).
# Brave Search: https://brave.com/search/api/ — results are labeled "web estimate — not book time".
# LABOR_WEB_SEARCH_PROVIDER=brave
# LABOR_WEB_SEARCH_API_KEY=replace-with-brave-search-api-key
# (alias also accepted: BRAVE_SEARCH_API_KEY)
