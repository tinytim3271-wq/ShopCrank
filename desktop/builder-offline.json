{
  "appId": "com.shopcrank.dispatch.offline",
  "productName": "ShopCrank Offline",
  "artifactName": "ShopCrank-Offline-Setup-${version}.${ext}",
  "publish": null,
  "directories": {
    "output": "dist/windows-offline"
  },
  "files": [
    "app.js",
    "diagnostics-ui.js",
    "index.html",
    "styles.css",
    "theme.css",
    "manifest.webmanifest",
    "service-worker.js",
    "shopcrank-icon.svg",
    "assets/**/*",
    "desktop/**/*",
    "diagnostics/j2534-host-node/**/*",
    "diagnostics/coverage/**/*",
    "downloads/**",
    "!desktop/packaged-secrets/**/*"
  ],
  "extraResources": [
    {
      "from": "diagnostics/j2534-host-node",
      "to": "j2534-host-node",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "diagnostics/j2534-service/publish/win-x64",
      "to": "j2534-host",
      "filter": [
        "J2534.Host.exe"
      ]
    },
    {
      "from": "diagnostics/keys",
      "to": "diagnostics-keys",
      "filter": [
        "capability-public-key.pem"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "ShopCrank Offline"
  }
}
