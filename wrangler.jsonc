{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shopcrank-api",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  // Production host is www.shopcrank.com.
  // Attach the Pages project shopcrank-dispatch as the custom domain for www.shopcrank.com
  // (and shopcrank.com if you want the apex to reach Pages). Attach this Worker only as
  // www.shopcrank.com/api/* and shopcrank.com/api/*. Binding the Worker to the whole
  // hostname conflicts with Pages.
  "workers_dev": false,
  "vars": {
    // Conversational AI: a shop's own Anthropic key (Shop settings > AI) answers first,
    // then the optional platform ANTHROPIC_API_KEY secret, otherwise the included
    // Workers AI binding below.
    "AI_ENABLED": "1",
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Default Claude model for shops that bring their own Anthropic key.
    "SHOP_ANTHROPIC_MODEL": "claude-sonnet-5",
    "SHOP_GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-tts",
    "ANTHROPIC_SONNET_MODEL": "claude-sonnet-5",
    "ANTHROPIC_OPUS_MODEL": "claude-opus-5",
    "DEEPGRAM_LISTEN_MODEL": "nova-3",
    "DEEPGRAM_SPEAK_MODEL": "flux-kit-en",
    "ALLOWED_ORIGINS": "https://www.shopcrank.com,https://shopcrank.com,https://shopcrank-dispatch.pages.dev,https://www.yourcarguy806.com",
    // Keep the legacy bridge until Google Cloud accepts the ShopCrank callback
    // (npm run verify:google-oauth). Then set this to https://www.shopcrank.com
    // and npm run deploy:worker.
    "GOOGLE_REDIRECT_ORIGIN": "https://www.yourcarguy806.com",
    "PAGES_ORIGIN": "https://shopcrank-dispatch.pages.dev",
    "AUTH_EMAIL_FROM": "noreply@shopcrank.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shopcrank",
      "database_id": "aa5434b8-9fe9-44ed-8e98-8f5b40bb2c26",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "shopcrank-files",
      "preview_bucket_name": "shopcrank-files-preview"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_CHAT_SESSIONS",
        "class_name": "AiChatSession"
      },
      {
        "name": "AI_VOICE_SESSIONS",
        "class_name": "AiVoiceSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-ai-voice-sessions",
      "new_sqlite_classes": ["AiVoiceSession"]
    },
    {
      "tag": "v2-ai-chat-sessions",
      "new_sqlite_classes": ["AiChatSession"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
